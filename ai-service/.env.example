# Copy this file to .env and add your own key. Never commit ai-service/.env.
GEMINI_API_KEY=
REQUIREMENTS_MODEL=gemini-3.5-flash-lite
SHECRAFT_BACKEND_URL=http://localhost:5000
# Set to true for a local course demo with synthetic conversations.
SHECRAFT_AGENT_TRACE=false

# Qdrant server. For a shared team database, use the same hosted/server URL
# and API key for every teammate. Local Docker is only reachable on this PC.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAG_ALLOWED_ORIGINS=http://localhost:3000

# Optional: keep this set to the VLM model already used in cached image descriptions.
# GEMINI_VLM_MODEL=
